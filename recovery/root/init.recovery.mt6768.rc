on init
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    setprop ro.crypto.type file
    setprop ro.crypto.state encrypted

on fs && property:ro.debuggable=0
    # distinguish USB should connect or not, i.e. CDP vs SDP
    # write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

# ----- Keymaster (Beanpod variant) -----
service vendor.keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service.beanpod
    class hal
    user root
    group root system
    priority -20
    disabled
    oneshot

# ----- Gatekeeper -----
service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class hal
    user root
    group root system
    disabled
    oneshot

# ----- Vibrator (MTK) -----
service vendor.vibrator /vendor/bin/hw/android.hardware.vibrator-service.mediatek
    class hal
    user root
    group root system
    disabled
    oneshot

on boot
    start vendor.keymaster-4-1
    start vendor.gatekeeper-1-0
    start vendor.vibrator
    start health-hal-2-1
    start boot-hal-1-2